{
  "id": "bec-guard-analysis-webhook",
  "name": "BEC Guard — normalized email analysis",
  "active": false,
  "nodes": [
    {
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "bec-guard/analyze",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "bec-guard-analyze",
      "credentials": {
        "httpHeaderAuth": {
          "id": "bec-guard-automation-header",
          "name": "BEC Guard automation"
        }
      }
    },
    {
      "id": "configuration",
      "name": "Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        440,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "backend-url",
              "name": "backend_url",
              "value": "SET_BACKEND_URL_ON_IMPORT",
              "type": "string"
            }
          ]
        },
        "options": {},
        "includeOtherFields": true
      }
    },
    {
      "id": "ingest-email",
      "name": "Ingest email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuration').item.json.backend_url + '/api/automation/emails' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $('Configuration').item.json.email }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 150000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "bec-guard-automation-header",
          "name": "BEC Guard automation"
        }
      },
      "retryOnFail": false,
      "onError": "continueRegularOutput"
    },
    {
      "id": "email-accepted",
      "name": "Email accepted",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        660,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "condition",
              "leftValue": "={{ [200, 201].includes($json.statusCode) && !!$json.body?.email?.id }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "analyze-email",
      "name": "Analyze email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        880,
        -100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuration').item.json.backend_url + '/api/automation/emails/' + $json.body.email.id + '/analyze' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 150000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "bec-guard-automation-header",
          "name": "BEC Guard automation"
        }
      },
      "retryOnFail": false,
      "onError": "continueRegularOutput"
    },
    {
      "id": "route-result",
      "name": "Route result",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [
        1100,
        -100
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "condition",
                    "leftValue": "={{ $json.body?.analysis?.status === 'ERROR' }}",
                    "rightValue": true,
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "ERROR"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "condition",
                    "leftValue": "={{ $json.statusCode === 200 && $json.body?.analysis?.status === 'COMPLETED' && ['HIGH', 'CRITICAL'].includes($json.body.analysis.risk_level) && !!$json.body.alert_id }}",
                    "rightValue": true,
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "ALERT"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "condition",
                    "leftValue": "={{ $json.statusCode === 200 && $json.body?.analysis?.status === 'COMPLETED' && ['LOW', 'MEDIUM'].includes($json.body.analysis.risk_level) && $json.body.alert_id === null }}",
                    "rightValue": true,
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "NO_ALERT"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      }
    },
    {
      "id": "alert",
      "name": "ALERT",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1360,
        -200
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ JSON.stringify({ route: 'ALERT', email_id: $json.body.analysis.email_id, analysis_id: $json.body.analysis.id, alert_id: $json.body.alert_id, status: $json.body.analysis.status, risk_score: $json.body.analysis.risk_score, risk_level: $json.body.analysis.risk_level, bec_type: $json.body.analysis.bec_type, summary: $json.body.analysis.summary, recommended_action: $json.body.analysis.recommended_action }) }}",
        "options": {}
      }
    },
    {
      "id": "no_alert",
      "name": "NO_ALERT",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1360,
        0
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ JSON.stringify({ route: 'NO_ALERT', email_id: $json.body.analysis.email_id, analysis_id: $json.body.analysis.id, alert_id: $json.body.alert_id, status: $json.body.analysis.status, risk_score: $json.body.analysis.risk_score, risk_level: $json.body.analysis.risk_level, bec_type: $json.body.analysis.bec_type, summary: $json.body.analysis.summary, recommended_action: $json.body.analysis.recommended_action }) }}",
        "options": {}
      }
    },
    {
      "id": "error",
      "name": "ERROR",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1360,
        200
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ JSON.stringify({route:'ERROR', status:'ERROR', error_code:$json.body?.analysis?.error_code || 'BACKEND_ANALYSIS_ERROR', email_id:$json.body?.analysis?.email_id || null, analysis_id:$json.body?.analysis?.id || null}) }}",
        "options": {}
      }
    },
    {
      "id": "ingest-error",
      "name": "Ingest ERROR",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        880,
        300
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\"route\":\"ERROR\",\"status\":\"ERROR\",\"error_code\":\"BACKEND_INGEST_ERROR\"}",
        "options": {}
      }
    },
    {
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1800,
        -100
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": "={{ $json.route === 'ERROR' ? ($json.error_code === 'LLM_NOT_CONFIGURED' ? 503 : 502) : 200 }}"
        }
      }
    },
    {
      "id": "imap-trigger",
      "name": "Email Trigger (IMAP)",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 2.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "mailbox": "INBOX",
        "postProcessAction": "nothing",
        "format": "resolved",
        "dataPropertyAttachmentsPrefixName": "attachment_",
        "options": {
          "customEmailConfig": "[\"ALL\"]",
          "trackLastMessageId": true
        }
      },
      "disabled": true
    },
    {
      "id": "normalize-imap",
      "name": "Normalize IMAP",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const mail = $json;\nconst values = (field) => {\n  if (!field) return [];\n  const entries = Array.isArray(field) ? field : [field];\n  return entries.flatMap(entry => Array.isArray(entry?.value) ? entry.value : []);\n};\nconst from = values(mail.from);\nif (from.length !== 1 || !from[0].address) throw new Error('IMAP_INVALID_FROM');\nconst reply = values(mail.replyTo);\nif (reply.length > 1) throw new Error('IMAP_MULTIPLE_REPLY_TO');\nif (typeof mail.text !== 'string' && mail.html) throw new Error('IMAP_MISSING_TEXT');\nconst header = (name) => {\n  const line = mail.headers?.[name];\n  if (typeof line !== 'string') return null;\n  return line.replace(new RegExp('^' + name + ':\\s*', 'i'), '').trim() || null;\n};\nconst returnPath = header('return-path');\nconst returnMatch = returnPath?.match(/^<?([^<>\\s]+@[^<>\\s]+)>?$/);\nconst date = mail.date && !Number.isNaN(Date.parse(mail.date)) ? new Date(mail.date) : new Date();\nif (!mail.messageId) throw new Error('IMAP_MISSING_MESSAGE_ID');\nreturn { json: { source: 'imap', email: {\n  message_id: mail.messageId,\n  thread_id: null,\n  sender_name: from[0].name || null,\n  sender_email: from[0].address,\n  reply_to: reply[0]?.address || null,\n  return_path: returnMatch?.[1] || null,\n  to_recipients: values(mail.to).map(entry => entry.address),\n  cc_recipients: values(mail.cc).map(entry => entry.address),\n  subject: mail.subject || '',\n  body_text: mail.text || '',\n  authentication_results: header('authentication-results'),\n  received_at: date.toISOString(),\n} } };"
      }
    },
    {
      "id": "prepare-webhook",
      "name": "Prepare webhook",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ JSON.stringify({ source: 'webhook', email: $json.body }) }}",
        "options": {}
      }
    },
    {
      "id": "is-webhook",
      "name": "Respond to webhook?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1580,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "condition",
              "leftValue": "={{ $('Configuration').item.json.source === 'webhook' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    }
  ],
